# Copy to server/.env (gitignored) and fill in. See README.md for each one.
DATABASE_URL=postgresql+asyncpg://prscout:prscout@127.0.0.1:20131/prscout
PRSCOUT_INTERNAL_KEY=
PRSCOUT_SECRET_KEY=
PRSCOUT_WEB_URL=http://127.0.0.1:3000   # production: https://gitprscout.com
GITHUB_TOKENS=
# Or read as the GitHub App (the maintainers' ops notes): all three, or none.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
PRSCOUT_JOB_CONCURRENCY=2
# Keep each report's evidence (README.md, "Evidence snapshots"). Empty = off.
PRSCOUT_EVIDENCE_DIR=
PRSCOUT_EVIDENCE_KEEP_DAYS=0
PRSCOUT_EVIDENCE_REUSE_HOURS=168
PRSCOUT_SIGNUP_AI_CREDITS=0
PRSCOUT_CLAIM_EVERY_DAYS=7
PRSCOUT_ANON_RATE_PER_HOUR=10
PRSCOUT_USER_RATE_PER_HOUR=60
# Pass checkout: off unless 1 (and the Razorpay keys are set).
PRSCOUT_PAYMENTS_ENABLED=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
