# Copy to .env.local and fill in. Never commit real values.

# --- PRScout API (server/) ---------------------------------------------------
# Called only from server code (route handlers, server components).
PRSCOUT_API_URL=http://127.0.0.1:8000
PRSCOUT_INTERNAL_KEY=change-me
# MOCK_API=1 serves realistic fixtures instead of calling PRSCOUT_API_URL.
# Good for development and demos while the server is being built.
MOCK_API=1
# The server refuses to start with MOCK_API=1 when NODE_ENV=production,
# unless this is set (for a demo deployment).
# ALLOW_MOCK_IN_PROD=1

# --- Proxy ----------------------------------------------------------------
# Set to 1 only when the app is reachable solely through our proxy
# (Cloudflare tunnel): then cf-connecting-ip / X-Forwarded-For are trusted as
# the visitor's IP for rate limiting. Leave unset anywhere else. On Vercel
# it isn't needed: the platform's own headers are used (lib/client-ip.ts).
# TRUST_PROXY_HEADERS=1

# --- Site -----------------------------------------------------------------
# The host shown in the "swap hub for PRScout" URL trick, badges and share links (production: gitprscout.com).
NEXT_PUBLIC_SITE_HOST=localhost:3000
# How many free AI reports a new user gets, as the site advertises it (the server grants the real
# number: PRSCOUT_SIGNUP_AI_CREDITS).
NEXT_PUBLIC_FREE_AI_QUOTA=3
# Shown on /terms, /privacy, /refunds and /contact. Left unset, the pages show
# the literal placeholders CONTACT_EMAIL / CONTACT_CITY so the gap is visible,
# and `next build` refuses unless PRSCOUT_ALLOW_PLACEHOLDER_CONTACT=1.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_CITY=

# --- Database (Auth.js users + sessions) ----------------------------------
# `docker compose up -d db` starts one on PRSCOUT_DB_PORT. Also holds the
# shared rate-limit counters (lib/limits.ts).
PRSCOUT_DB_PORT=5432
DATABASE_URL=postgres://prscout:prscout@127.0.0.1:5432/prscout
# Neon on Vercel: DATABASE_URL is the pooled address (host with "-pooler"),
# DATABASE_URL_UNPOOLED the direct one, which migrations use
# (drizzle.config.ts; `npm run vercel-build` migrates on production builds).
# DATABASE_URL_UNPOOLED=

# --- Auth.js --------------------------------------------------------------
# The public URL of this site. Required in production (OAuth callbacks).
AUTH_URL=http://localhost:3000
# openssl rand -base64 32. Required in production; empty is fine in development.
AUTH_SECRET=
# Leave both providers empty in development to get the dev-only sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email and password accounts ------------------------------------------
# "Forgot password" emails go through Resend. Without a key, reset is off in
# production; in development the link is shown on the page instead.
RESEND_API_KEY=
# The sender, on a domain verified in Resend. Falls back to
# PRSCOUT_ALERT_EMAIL_FROM.
PRSCOUT_AUTH_EMAIL_FROM=
